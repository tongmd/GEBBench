{
 "rubric": {
  "R1_nodes": "Every class of repeated drawn primitive (circle/dot/square/tile/strand endpoint/box) becomes a node. Repetition counts are nuisance: chains and rings are reduced to <=6 elements preserving any 2-periodic pattern; cliques to K3; stars to center+5; grids to the minimal deviant neighborhood. Every reduction is listed in the motif's provenance.",
  "R2_node_types": "u = generic unit; s0/s1 = one of exactly two visually distinguished states/species (fill parity, tile species, point-vs-line role, strand start/end bank); d = the unique distinguished element (larger radius, deviant color, unpaired center, cut vertex, sink, fixed point, floor, overloaded box, beat marker). Each type must be traceable to an explicit visual distinction in skeleton_spec.",
  "R3_edge_types": "link = a drawn connection between units (segment, arc, spoke, clique edge); contain = an arrow explicitly stated to point to a deeper/inner element; self = a drawn or equation-level self-loop (unique self-edge, f(x*)=x*, psi<->phi(code(psi))); back = a visually distinguished return edge that closes a closed walk (drawn separately from the uniform edges, e.g. a Bezier return curve); map = a correspondence edge between two distinctly drawn groups (dashed pairing line, rung, assignment arrow into a box, diagonal-to-escape-row arrow); twist = an edge explicitly drawn as a crossing / exchange with over-under gaps (Mobius crossover, braid swap).",
  "R4_direction": "An edge is directed iff the spec draws an arrowhead (marker) or assigns an explicit level/order index (layer depth d, ladder height, strictly decreasing labels, iteration order); otherwise both directions are inserted.",
  "R5_costs_nodes": "GED node substitution: 0 same type; 0.25 s0<->s1 (the two state labels are exchangeable); 0.5 u<->s*; 1.0 d<->anything else. Insert/delete 1.0.",
  "R6_costs_edges": "GED edge substitution: 0 same type; 0.5 link<->contain (containment is a specialized link); 1.0 any other type pair. Insert/delete 1.0.",
  "R7_normalization": "GED(g1,g2) normalized by (|V1|+|V2|+|E1|+|E2|), the cost of deleting g1 and inserting g2."
 },
